# Copy this file to .env.local and fill in your credentials

# MongoDB connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<db>?retryWrites=true&w=majority

# Optional: override DB name used by Mongoose
# MONGODB_DB=smart-cart

# Gemini API key for Assistant Search (do NOT commit real key)
# GEMINI_API_KEY=AIzaSy...
# Optional: Override default Gemini model
# GEMINI_MODEL=gemini-1.5-flash-latest

# (Deprecated) Groq configuration — no longer used
# GROQ_API_KEY=
# GROQ_TEXT_MODEL=
# GROQ_VISION_MODEL=

